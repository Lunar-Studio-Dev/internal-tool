// Lunar Studio — Client Management Tool
// Models are introduced phase by phase (PHASE_3 onward).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── PHASE_3 — Team Members & Roles (RBAC) ───

enum RoleName {
  ADMIN
  CLIENT_MANAGER
  BUSINESS_ANALYST
  SALES
  FINANCE
  DEVELOPER
  PROJECT_MANAGER
}

enum MemberStatus {
  ACTIVE
  INACTIVE
  PENDING
}

/// Domain profile for a person using the tool. Linked to a Neon Auth
/// (neon_auth.user) identity via `authUserId` — a plain string, no cross-schema
/// FK. Set at provisioning (auth.admin.createUser); null only for the manually
/// inserted bootstrap admin until first sign-in. `roles` is an enum array — a
/// member's roles live in one row. Members are never hard-deleted; they go INACTIVE.
model TeamMember {
  id         String       @id @default(cuid())
  authUserId String?      @unique
  name       String
  email      String       @unique
  phone      String?
  image      String?
  roles      RoleName[]
  status     MemberStatus @default(ACTIVE)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@map("team_member")
}
