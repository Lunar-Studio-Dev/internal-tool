# ─── Database (Neon serverless Postgres — pooled connection string) ───
DATABASE_URL=

# ─── App ───
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Neon Auth = Managed Better Auth (Neon console → Auth → Configuration) ───
# Base URL of your Managed Better Auth server
# e.g. https://ep-xxxx.neonauth.us-east-1.aws.neon.tech/neondb/auth
NEON_AUTH_BASE_URL=
# Secret for signing session cookies — must be 32+ chars. Generate: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=

# ─── Inngest (cron jobs & workflows; dev server needs no keys locally) ───
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ─── Cloudflare R2 (S3-compatible object storage) ───
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# ─── Vercel AI Gateway (Google / Gemini via gateway) ───
AI_GATEWAY_API_KEY=
GOOGLE_API_KEY=
